{
  "name": "firmachain-nft-explorer",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "scripts": {
    "start": "env-cmd -f .env craco start",
    "build": "GENERATE_SOURCEMAP=false env-cmd -f .env craco build",
    "deploy-mainnet": "aws s3 sync ./build s3://deploy-ecosystem/mainnet/nft-explorer --profile=firmachain-deploy --delete",
    "invalidate-mainnet": "aws cloudfront create-invalidation --profile=firmachain-deploy --distribution-id E3FQGPV7MAF5N8 --paths '/*'"
  },
  "dependencies": {
    "@apollo/client": "^3.7.0",
    "@apollo/react-hooks": "^4.0.0",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@firmachain/firma-js": "^0.3.3",
    "axios": "^1.1.3",
    "graphql": "^16.6.0",
    "moment": "^2.29.4",
    "notistack": "^2.0.8",
    "react": "^18.2.0",
    "react-card-flip": "^1.2.0",
    "react-content-loader": "^6.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "react-query": "^3.39.3",
    "react-responsive": "^9.0.2",
    "react-router-dom": "^6.4.2",
    "react-scripts": "^5.0.1",
    "react-slick": "^0.29.0",
    "react-spinners": "^0.13.8",
    "slick-carousel": "^1.8.1",
    "styled-components": "^5.3.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.66",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/react-slick": "^0.23.10",
    "@types/styled-components": "^5.1.26",
    "@types/uuid": "^9.0.2",
    "browserify-fs": "^1.0.0",
    "crypto-browserify": "^3.12.0",
    "crypto-js": "^4.1.1",
    "env-cmd": "^10.1.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "^4.8.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
